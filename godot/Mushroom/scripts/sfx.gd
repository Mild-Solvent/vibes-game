extends Node
## Autoload "Sfx": sound effects and ambience.
##
## Sounds live in res://assets/sfx/ ("k:" = Kenney CC0 packs in kenney/, "s:" = procedurally synthesized in
## synth/, regenerated by assets/sfx/tools/gen_sfx.py). Positional one-shots use a pool of AudioStreamPlayer3D;
## the ambience is three quiet 2D loops (day / dusk / night) crossfaded by set_time_of_day().
## In --headless nothing is played, but `heard` still fires so the host's monsters can hunt by sound.

## Emitted on this peer for every positional sound (also headless), so AI can react: range_m is how far it carries.
signal heard(sound: String, pos: Vector3, range_m: float)

const KENNEY_DIR := "res://assets/sfx/kenney/"
const SYNTH_DIR := "res://assets/sfx/synth/"
const MAX_VOICES := 40
const AMBIENCE_DB := -14.0  ## loudness of a fully faded-in ambience loop
const AMBIENCE_FADE := 0.25  ## how fast the ambience weights follow the time of day, per second
const CREEP_DB := -6.0  ## extra attenuation of the random night one-shots

## name -> [variants, range in metres, volume dB, random pitch +-]. A random variant is picked each time.
const SOUNDS := {
	"footstep": [["k:footstep_grass_000", "k:footstep_grass_001", "k:footstep_grass_002",
